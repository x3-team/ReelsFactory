{
  "name": "reelsfactory",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:prod": "bash scripts/start-prod.sh",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "MOCK_EXTERNAL_APIS=true DATABASE_URL=\"${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:5432/reelsfactory?schema=public}\" tsx --tsconfig tsconfig.json --test src/lib/ai/aitunnel.test.ts src/lib/ai/normalize-strategy.test.ts src/lib/ai/source-anchors.test.ts src/lib/ai/generate-strategy.test.ts src/lib/ai/transcribe.test.ts src/lib/ai/fact-extractor.test.ts src/lib/billing/quota.test.ts src/lib/content/scrape-limits.test.ts src/lib/scraping/apify-reuse.test.ts src/lib/scraping/tiktok-media.test.ts src/lib/platform.test.ts src/lib/config.test.ts src/lib/script-meta.test.ts src/lib/pipeline/analysis-cycle.test.ts",
    "test:http": "tsx --tsconfig tsconfig.json scripts/http-cycle.ts",
    "test:apify-reuse": "tsx --tsconfig tsconfig.json scripts/check-apify-reuse.ts",
    "scrape:resume": "tsx --tsconfig tsconfig.json scripts/resume-scrape.ts",
    "strategy:reuse": "MOCK_EXTERNAL_APIS=false APIFY_REUSE_ONLY=true tsx --tsconfig tsconfig.json scripts/reuse-strategy-ping.ts",
    "strategy:corpus": "MOCK_EXTERNAL_APIS=false tsx --tsconfig tsconfig.json scripts/corpus-reuse-strategy.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@telegram-apps/sdk": "^3.11.8",
    "@telegram-apps/sdk-react": "^3.3.9",
    "bullmq": "^6.0.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.31.0",
    "next": "14.2.35",
    "openai": "^7.4.0",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
