DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reelsfactory?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="ReelsFactoryBot"

# Public legal entity (landing / offer). Not secrets.
# NEXT_PUBLIC_LEGAL_NAME=
# NEXT_PUBLIC_LEGAL_INN=
# NEXT_PUBLIC_LEGAL_OGRNIP=
# NEXT_PUBLIC_LEGAL_ADDRESS=
# NEXT_PUBLIC_SUPPORT_EMAIL=support@reelsfactory.app

# Telegram bot token for initData HMAC validation (required in production)
TELEGRAM_BOT_TOKEN=
REQUIRE_TELEGRAM_AUTH="false"

# Force every external call onto demo data (even if keys exist).
# MOCK_EXTERNAL_APIS=true
# Allow a demo profile when scrape keys are missing. Live AI stays off for that run.
# ALLOW_MOCK_PROFILE=true

# AITunnel — единый API ко всем моделям (https://aitunnel.ru / docs.aitunnel.ru)
AITUNNEL_API_KEY=
AITUNNEL_BASE_URL="https://api.aitunnel.ru/v1/"
AITUNNEL_LLM_MODEL="deepseek-v4-flash"
# Pro/Agency tier (override optional)
AITUNNEL_LLM_MODEL_PRO="gpt-5.6-terra"
AITUNNEL_WHISPER_MODEL="whisper-1"
# OCR кадров для роликов без речи (process / music)
AITUNNEL_VISION_MODEL="gpt-4o-mini"
# VISION_DISABLED=true

# Optional alias if you already use OPENAI_* naming with AITunnel key
OPENAI_API_KEY=

# Optional Redis for BullMQ analysis queue (required in production)
REDIS_URL=redis://localhost:6379
# Emergency only — allow in-process queue in production
# ALLOW_MEMORY_QUEUE=true

# Telegram bot webhook (comment-keyword auto-reply). Same secret in setWebhook secret_token.
TELEGRAM_WEBHOOK_SECRET=
# Auto-register webhook on boot in production, or force in dev:
# REGISTER_TELEGRAM_WEBHOOK=true
# Optional extra secret for POST /api/telegram/setup
# TELEGRAM_SETUP_SECRET=

# Payments
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Optional: put the same value in the YooKassa notification URL as ?secret=
YOOKASSA_WEBHOOK_SECRET=

# Scraping — Apify preferred for Instagram (videoUrl → Whisper)
APIFY_TOKEN=
# Optional override (default: apify/instagram-profile-scraper)
# APIFY_INSTAGRAM_ACTOR=apify/instagram-profile-scraper
# Extra reels/posts when the profile actor returns too few videos
# APIFY_INSTAGRAM_POSTS_ACTOR=apify/instagram-scraper
# APIFY_IG_POSTS_TYPE=reels
# APIFY_SKIP_POSTS_ACTOR=true
# TikTok (default: clockworks/tiktok-profile-scraper)
# APIFY_TIKTOK_ACTOR=clockworks/tiktok-profile-scraper
RAPIDAPI_KEY=

# Cost controls
APIFY_MONTHLY_CAP=200
SCRAPE_CACHE_TTL_HOURS=24
# ALLOW_MOCK_PAYMENTS=true
# ALLOW_PUBLIC_AI_DEBUG=true
