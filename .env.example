DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reelsfactory?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="ReelsFactoryBot"

# Telegram bot token for initData HMAC validation (required in production)
TELEGRAM_BOT_TOKEN=
REQUIRE_TELEGRAM_AUTH="false"

# Set to "true" to use demo scraping/LLM/payment responses without external keys
MOCK_EXTERNAL_APIS="true"

# AITunnel — единый API ко всем моделям (https://aitunnel.ru / docs.aitunnel.ru)
AITUNNEL_API_KEY=
AITUNNEL_BASE_URL="https://api.aitunnel.ru/v1/"
AITUNNEL_LLM_MODEL="gpt-5.6-luna"
# Pro/Agency tier (override optional)
AITUNNEL_LLM_MODEL_PRO="gpt-5.6-terra"
AITUNNEL_WHISPER_MODEL="whisper-1"

# Optional alias if you already use OPENAI_* naming with AITunnel key
OPENAI_API_KEY=

# Scraping — Apify preferred (videoUrl → Whisper)
APIFY_TOKEN=
# Optional overrides
# APIFY_INSTAGRAM_ACTOR=apify/instagram-profile-scraper
# APIFY_TIKTOK_ACTOR=clockworks/tiktok-profile-scraper
RAPIDAPI_KEY=

# Payments
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=

# Optional Redis for BullMQ analysis queue (falls back to in-process queue)
REDIS_URL=

# Weekly Telegram nudge + webhook secret (same value on web and cron)
CRON_SECRET=
