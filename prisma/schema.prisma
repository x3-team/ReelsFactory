// ReelsFactory — Prisma schema (PostgreSQL)
// Models: User, ProfileAnalysis, Script, Payment, Referral, ClientAccount

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProfileGoal {
  GROW_AUDIENCE
  SELL_PRODUCT
}

enum ToneOfVoice {
  DIRECT
  HUMOROUS
  EXPERT
  STORYTELLING
}

enum SubscriptionPlan {
  FREE
  START
  PRO
  AGENCY
}

enum AnalysisStatus {
  PENDING
  QUEUED
  SCRAPING
  TRANSCRIBING
  GENERATING
  /// Подписи слабые — ждём 3 факта от пользователя, сценарии не выдаём
  NEEDS_FACTS
  COMPLETED
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PaymentProvider {
  YOOKASSA
  CLOUDPAYMENTS
}

enum ReferralStatus {
  PENDING
  CREDITED
  PAID_OUT
}

/// Telegram Mini App user + onboarding / subscription state
model User {
  id           String  @id @default(cuid())
  telegramId   BigInt  @unique
  username     String?
  firstName    String?
  lastName     String?
  languageCode String?
  photoUrl     String?

  /// Instagram / TikTok @username or YouTube channel URL
  socialHandle String?
  /// instagram | tiktok | youtube
  platform     String?

  profileGoal  ProfileGoal?
  websiteUrl   String?
  offerSummary String?
  toneOfVoice  ToneOfVoice?

  subscriptionPlan      SubscriptionPlan @default(FREE)
  subscriptionExpiresAt DateTime?
  /// Referral credit balance (RUB)
  referralBalance       Decimal          @default(0) @db.Decimal(12, 2)

  referrerId    String?
  referrer      User?   @relation("UserReferrals", fields: [referrerId], references: [id])
  referredUsers User[]  @relation("UserReferrals")

  /// Last weekly “unsthot scripts” Telegram nudge
  lastNudgeAt DateTime?

  analyses          ProfileAnalysis[]
  scripts           Script[]
  payments          Payment[]
  referralsGiven    Referral[]      @relation("Referrer")
  referralsReceived Referral[]      @relation("Referred")
  clientAccounts    ClientAccount[]

  onboardedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([referrerId])
}

/// Agency plan: up to N client social accounts under one owner
model ClientAccount {
  id           String @id @default(cuid())
  agencyUserId String
  agencyUser   User   @relation(fields: [agencyUserId], references: [id], onDelete: Cascade)

  label        String?
  socialHandle String
  platform     String

  analyses ProfileAnalysis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyUserId])
  @@unique([agencyUserId, socialHandle])
}

/// One analysis run for a social profile (bio + top videos + LLM strategy)
model ProfileAnalysis {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientAccountId String?
  clientAccount   ClientAccount? @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)

  socialHandle String
  platform     String
  status       AnalysisStatus @default(PENDING)
  jobId        String?

  niche            String?
  targetAudience   String?
  /// [{ "title": string, "description": string }]
  contentPillars   Json?
  /// string[]
  profileAuditTips Json?
  /// Scraped bio, followers, top video metadata
  rawProfileData   Json?
  /// Whisper transcriptions for top videos
  transcriptions   Json?
  /// empty | weak | ok
  sourceStrength   String?
  /// string[] — 3 факта от пользователя, если подписи слабые
  sourceFacts      Json?
  /// Whisper дал пригодную речь (не музыка/заставка)
  voiceHeard       Boolean?
  errorMessage     String?

  scripts Script[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([clientAccountId])
}

/// Generated reel / short script with teleprompter text
model Script {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisId String
  analysis   ProfileAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  title              String
  format             String
  /// string[] — alternative hooks
  hookOptions        Json
  teleprompterScript String  @db.Text
  caption            String  @db.Text
  cta                String
  /// { start0_3s?: string, midAction?: string, finalCta?: string }
  visualCues         Json?
  /// Free-plan teaser (1 script) vs full unlocked script
  isTeaser           Boolean @default(false)
  /// Автор отметил, что ролик снят / опубликован
  shotAt             DateTime?
  publishedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([analysisId])
}

/// Subscription payment (YoKassa / CloudPayments)
model Payment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount   Decimal          @db.Decimal(12, 2)
  currency String           @default("RUB")
  plan     SubscriptionPlan
  status   PaymentStatus    @default(PENDING)
  provider PaymentProvider  @default(YOOKASSA)

  providerPaymentId String? @unique
  metadata          Json?

  referral Referral?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

/// One referral payout credit per paid payment (30% first / 10% renewals)
model Referral {
  id         String @id @default(cuid())
  referrerId String
  referrer   User   @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId String
  referred   User   @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)

  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id])

  creditAmount   Decimal        @db.Decimal(12, 2)
  commissionRate Decimal        @default(0.3) @db.Decimal(5, 4)
  isRenewal      Boolean        @default(false)
  status         ReferralStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referrerId])
  @@index([referredId])
}
