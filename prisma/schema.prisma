// ReelsFactory — Prisma schema (PostgreSQL)
// Models: User, ProfileAnalysis, Script, Payment, Referral, ClientAccount

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProfileGoal {
  GROW_AUDIENCE
  SELL_PRODUCT
}

enum ToneOfVoice {
  DIRECT
  HUMOROUS
  EXPERT
  STORYTELLING
}

enum SubscriptionPlan {
  FREE
  START
  PRO
  AGENCY
}

enum AnalysisStatus {
  PENDING
  QUEUED
  SCRAPING
  TRANSCRIBING
  GENERATING
  COMPLETED
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PaymentProvider {
  YOOKASSA
  CLOUDPAYMENTS
}

enum ReferralStatus {
  PENDING
  CREDITED
  PAID_OUT
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

/// Telegram Mini App user + onboarding / subscription state
model User {
  id           String  @id @default(cuid())
  telegramId   BigInt  @unique
  username     String?
  firstName    String?
  lastName     String?
  languageCode String?
  photoUrl     String?

  /// Instagram / TikTok @username or YouTube channel URL
  socialHandle String?
  /// instagram | tiktok | youtube
  platform     String?

  profileGoal  ProfileGoal?
  websiteUrl   String?
  offerSummary String?
  toneOfVoice  ToneOfVoice?
  /// beauty | realty | clinic | coach | shop | edtech | food | smm | custom
  nichePreset  String?
  /// Voice/idea draft pasted by user (Telegram voice → text)
  voiceDraft   String? @db.Text
  /// Author-pasted reel URLs + optional Insights (safer than silent IG scrape)
  submittedReels Json?

  subscriptionPlan      SubscriptionPlan @default(FREE)
  subscriptionExpiresAt DateTime?
  /// Referral credit balance (RUB)
  referralBalance       Decimal          @default(0) @db.Decimal(12, 2)

  referrerId    String?
  referrer      User?   @relation("UserReferrals", fields: [referrerId], references: [id])
  referredUsers User[]  @relation("UserReferrals")

  analyses          ProfileAnalysis[]
  scripts           Script[]
  payments          Payment[]
  referralsGiven    Referral[]      @relation("Referrer")
  referralsReceived Referral[]      @relation("Referred")
  clientAccounts    ClientAccount[]
  hookFeedback      HookFeedback[]
  referralPayouts   ReferralPayout[]
  reminders         Reminder[]

  onboardedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([referrerId])
}

/// Agency plan: up to N client social accounts under one owner
model ClientAccount {
  id           String @id @default(cuid())
  agencyUserId String
  agencyUser   User   @relation(fields: [agencyUserId], references: [id], onDelete: Cascade)

  label        String?
  socialHandle String
  platform     String
  /// Per-client brief (Agency 2.0)
  profileGoal  ProfileGoal?
  toneOfVoice  ToneOfVoice?
  offerSummary String?
  nichePreset  String?
  websiteUrl   String?

  analyses ProfileAnalysis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyUserId])
  @@unique([agencyUserId, socialHandle])
}

/// One analysis run for a social profile (bio + top videos + LLM strategy)
model ProfileAnalysis {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientAccountId String?
  clientAccount   ClientAccount? @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)

  socialHandle String
  platform     String
  status       AnalysisStatus @default(PENDING)
  jobId        String?

  niche            String?
  targetAudience   String?
  /// [{ "title": string, "description": string }]
  contentPillars   Json?
  /// string[]
  profileAuditTips Json?
  /// Scraped bio, followers, top video metadata
  rawProfileData   Json?
  /// Whisper transcriptions for top videos
  transcriptions   Json?
  /// Shoot-day session plan (outfit, props, order, extra ideas)
  shootDayPlan     Json?
  /// 7-day pillars calendar
  pillarsCalendar  Json?
  /// Default comment→Telegram funnel kit
  funnelKit        Json?
  /// Template tips for «why didn't viral» reshoots
  autopsyTemplate  Json?
  errorMessage     String?

  scripts Script[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([clientAccountId])
}

/// Generated reel / short script with teleprompter text
model Script {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisId String
  analysis   ProfileAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  title              String
  format             String
  /// string[] — alternative hooks
  hookOptions        Json
  teleprompterScript String  @db.Text
  caption            String  @db.Text
  cta                String
  /// Free-plan teaser (1 script) vs full unlocked script
  isTeaser           Boolean @default(false)

  durationSec      Int?
  commentKeyword   String?
  /// { reels, vk_clips, shorts, telegram_post }
  platformPacks    Json?
  /// { comment_keyword, bot_reply, lead_magnet, telegram_cta }
  funnel           Json?
  /// string[] — props to prepare
  propsChecklist   Json?
  shootOrder       Int?
  /// core | shoot_day | remake | autopsy
  sourceType       String  @default("core")
  /// Product / caption this script is based on
  sourceAngle      String?
  /// string[] — shot list for process videos
  shotList         Json?

  hookFeedback HookFeedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([analysisId])
  @@index([commentKeyword])
}

/// Whisper transcript cache — same reel must not be billed twice
model WhisperCache {
  id        String   @id @default(cuid())
  videoKey  String   @unique
  text      String   @db.Text
  source    String   @default("whisper")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Profile scrape cache (Apify/Rapid) — TTL enforced in code
model ScrapeCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  profile   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Meter for Apify / Whisper / LLM spend control
model CostEvent {
  id        String   @id @default(cuid())
  kind      String
  userId    String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([userId])
}

/// A/B: creator marks which hook flew after publishing
model HookFeedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scriptId  String
  script    Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  hookIndex Int
  outcome   String
  createdAt DateTime @default(now())

  @@unique([scriptId, hookIndex])
  @@index([userId])
}

/// Subscription payment (YoKassa / CloudPayments)
model Payment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount   Decimal          @db.Decimal(12, 2)
  currency String           @default("RUB")
  plan     SubscriptionPlan
  status   PaymentStatus    @default(PENDING)
  provider PaymentProvider  @default(YOOKASSA)

  providerPaymentId String? @unique
  metadata          Json?

  referral Referral?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

/// One referral payout credit per paid payment (30% first / 10% renewals)
model Referral {
  id         String @id @default(cuid())
  referrerId String
  referrer   User   @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId String
  referred   User   @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)

  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id])

  creditAmount   Decimal        @db.Decimal(12, 2)
  commissionRate Decimal        @default(0.3) @db.Decimal(5, 4)
  isRenewal      Boolean        @default(false)
  status         ReferralStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referrerId])
  @@index([referredId])
}

/// Atomic monthly quotas (increment-if-below-limit)
model UsageCounter {
  id        String @id @default(cuid())
  userId    String
  year      Int
  month     Int
  analyses  Int    @default(0)
  scripts   Int    @default(0)
  remakes   Int    @default(0)
  autopsies Int    @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, year, month])
  @@index([userId])
}

/// Pending referral from bot /start ref_ before Mini App open
model BotSession {
  telegramId         BigInt    @id
  referrerTelegramId BigInt?
  lastKeyword        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/// Cash-out request from referral balance (manual payout)
model ReferralPayout {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Decimal      @db.Decimal(12, 2)
  requisites String
  status     PayoutStatus @default(PENDING)
  note       String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([userId])
  @@index([status])
}

/// Telegram nudge that keeps the shooting cadence going ("сними сценарий 2")
model Reminder {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisId String?
  /// shoot_next_script | cadence_week
  kind       String
  text       String   @db.Text
  dueAt      DateTime
  sentAt     DateTime?
  /// Set when Telegram rejected the message, so a retry loop does not spin
  failedAt   DateTime?
  createdAt  DateTime @default(now())

  @@unique([userId, analysisId, kind])
  @@index([sentAt, dueAt])
}
